# Project: ScamCheck NG | Developer: Qunbuliy
# Copy this file to .env and fill in real values. NEVER commit .env.

PORT=3000
NODE_ENV=development

# Secret used to sign JWT auth cookies (change to a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Salt used to hash IP addresses (change this too)
IP_HASH_SALT=change-me-ip-salt

# First admin account created by "npm run seed"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Allowed origin for CORS (your frontend URL)
CLIENT_ORIGIN=http://localhost:3000

# Path to the SQLite database file
DB_PATH=./server/scamcheck.db